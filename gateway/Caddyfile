{
	admin off
	auto_https off
}

:{$PORT:8080} {
	handle /healthz {
		respond "ok" 200
	}

	@authorized header Authorization "Bearer {$MCP_API_TOKEN}"
	handle @authorized {
		reverse_proxy {$MCP_UPSTREAM} {
			header_up -Authorization
			header_up Host {upstream_hostport}
			flush_interval -1
			transport http {
				read_timeout 10m
			}
		}
	}

	handle {
		respond "Unauthorized" 401
	}
}
